# docsguard needs no secrets. Nothing below is a credential; every value is a default you can leave alone.
# Copy to .env only if you want to pin one. docker compose reads .env; the playground server reads the DG_* variables.

# --- the guards, run from a container ---------------------------------------------------------------------------
# The repository the containerised guards inspect (mounted read-only, with no network and no capabilities).
TARGET=.

# --- the playground (make playground) ---------------------------------------------------------------------------
# Host port on the loopback of this machine. 8000, 8090 and 8100 are commonly taken by the sibling projects.
DG_PORT=8200

# The lab: the endpoints that change the sample project. On for the demo. The server REFUSES to start with
# DG_LAB=1 when DG_ENV=production, because the lab has no login on purpose.
DG_LAB=1
DG_ENV=development

# Where the server binds, and which extra Host names it answers to (names only, comma separated). The image binds
# 0.0.0.0 because a container must, and compose publishes the port on 127.0.0.1 only; run outside a container, keep the
# loopback. localhost, 127.0.0.1 and [::1] are always allowed; any other Host header is answered with 403, which is
# what defeats DNS rebinding.
DG_BIND=127.0.0.1
DG_ALLOWED_HOSTS=

# The folder the server serves the landing page and the lab from (the image sets this; only change it to try a site
# of your own).
DG_SITE_DIR=

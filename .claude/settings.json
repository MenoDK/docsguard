{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=\"$CLAUDE_PROJECT_DIR/src\" python3 -m docsguard hook git-guard"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=\"$CLAUDE_PROJECT_DIR/src\" python3 -m docsguard hook scope-guard"
          }
        ]
      }
    ]
  }
}
